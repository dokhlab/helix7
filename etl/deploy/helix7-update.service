[Unit]
Description=Helix7 GPCRome data refresh
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
# This release is the live Helix7 v3 MariaDB deployment.
User=jwang
WorkingDirectory=/home/html/sites/helix7-v3-stage
ExecStart=/home/html/sites/helix7-v3-stage/run update
# a refresh with fresh PubMed counts takes a few minutes; cap generously
TimeoutStartSec=3600
Nice=10

[Install]
WantedBy=multi-user.target
