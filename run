#!/usr/bin/env bash
#
# Helix7 — local helper and ETL entry point (MariaDB).
#
#   ./run           start the local MariaDB and the Next.js dev server
#   ./run status    show what is currently up
#   ./run stop      stop the local MariaDB (data volume kept)
#   ./run etl       run the full data pipeline into MariaDB
#   ./run update    scheduled refresh: clear the cache, rebuild, record the run
#
# Settings come from run.env if present (a server's own settings, git-ignored),
# otherwise .env.local, which is created from .env.example on first use.
#
set -euo pipefail

APP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$APP_DIR"

if [ -f run.env ]; then
  CONFIG=run.env
else
  [ -f .env.local ] || cp .env.example .env.local
  CONFIG=.env.local
fi
set -a
# shellcheck disable=SC1090
. "./$CONFIG"
set +a

WEB_PORT="${PORT:-3000}"
DB_NAME="${HELIX7_DBNAME:-helix7}"
DB_CONTAINER="${HELIX7_DB_CONTAINER:-helix7-db}"
ETL_NETWORK="${HELIX7_ETL_NETWORK:-helix7_default}"
ETL_DBHOST="${HELIX7_ETL_DBHOST:-db}"
ETL_DBPORT="${HELIX7_ETL_DBPORT:-3306}"
ETL_ENV_FILE="${HELIX7_ETL_ENV_FILE:-$CONFIG}"
# Only manage the database container when it is this project's own.
LOCAL_DB=$([ "$DB_CONTAINER" = helix7-db ] && echo 1 || echo 0)

bold=$'\033[1m'; dim=$'\033[2m'; green=$'\033[32m'; yellow=$'\033[33m'
red=$'\033[31m'; cyan=$'\033[36m'; reset=$'\033[0m'

step() { printf '%s==>%s %s%s%s\n' "$cyan" "$reset" "$bold" "$1" "$reset"; }
ok()   { printf '  %s✓%s %s\n' "$green" "$reset" "$1"; }
warn() { printf '  %s!%s %s\n' "$yellow" "$reset" "$1"; }
die()  { printf '  %s✗%s %s\n' "$red" "$reset" "$1" >&2; exit 1; }

# The compose plugin isn't always installed; fall back to the standalone binary.
detect_compose() {
  if docker compose version >/dev/null 2>&1; then
    COMPOSE=(docker compose)
  elif command -v docker-compose >/dev/null 2>&1; then
    COMPOSE=(docker-compose)
  else
    die "neither 'docker compose' nor 'docker-compose' is installed"
  fi
}

docker_up() { docker info >/dev/null 2>&1; }

start_docker() {
  step "Docker engine"
  if docker_up; then
    ok "already running"
    return
  fi
  if command -v colima >/dev/null 2>&1; then
    warn "daemon not reachable — starting Colima (first boot takes ~60s)"
    colima start --cpu 2 --memory 4 --disk 20 >/dev/null 2>&1 || true
    for _ in $(seq 1 60); do
      docker_up && { ok "Colima up"; return; }
      sleep 2
    done
    die "Colima did not become ready — try 'colima start' manually"
  fi
  die "Docker is not running. Start Docker Desktop (or Colima) and re-run."
}

db_running() { [ -n "$(docker ps -q -f "name=^${DB_CONTAINER}$" 2>/dev/null)" ]; }

start_db() {
  step "MariaDB"
  if [ "$LOCAL_DB" = 0 ]; then
    db_running && ok "using ${DB_CONTAINER}" || die "database container ${DB_CONTAINER} is not running"
    return
  fi
  if db_running; then
    ok "container already running"
  else
    # No --remove-orphans: other projects may share this Docker daemon.
    "${COMPOSE[@]}" up -d db >/dev/null 2>&1 || die "failed to start the database container"
    ok "container started"
  fi

  printf '  %swaiting for MariaDB to accept connections…%s' "$dim" "$reset"
  for _ in $(seq 1 60); do
    if [ "$(docker inspect -f '{{.State.Health.Status}}' "$DB_CONTAINER" 2>/dev/null)" = healthy ]; then
      printf '\r\033[K'; ok "ready on ${DBHOST:-127.0.0.1}:${DBPORT:-3307} (database ${DB_NAME})"
      return
    fi
    printf '.'; sleep 2
  done
  printf '\r\033[K'
  die "MariaDB never became ready — check: docker logs $DB_CONTAINER"
}

report_data() {
  step "Dataset"
  local counts
  counts=$(docker exec -e REPORT_DB="$DB_NAME" "$DB_CONTAINER" sh -c \
    'mariadb -uroot -p"$MYSQL_ROOT_PASSWORD" -NBe \
      "SELECT (SELECT COUNT(*) FROM \`${REPORT_DB}\`.receptors), \
              (SELECT COUNT(*) FROM \`${REPORT_DB}\`.ligands), \
              (SELECT COUNT(*) FROM \`${REPORT_DB}\`.bioactivities);"' \
    2>/dev/null | tr -d '\r' || echo "")

  read -r receptors ligands acts <<<"${counts:-0 0 0}"
  if [ "${receptors:-0}" -gt 0 ] 2>/dev/null; then
    ok "${receptors} receptors · ${ligands} ligands · ${acts} bioactivities"
  else
    warn "database is empty — load it with: ./run etl"
  fi
}

install_deps() {
  step "Node dependencies"
  if [ ! -d node_modules ]; then
    warn "node_modules missing — installing (this takes a minute)"
    npm install
  fi
  ok "installed"
}

start_web() {
  step "Next.js dev server"
  printf '  %shttp://localhost:%s%s\n\n' "$bold" "$WEB_PORT" "$reset"
  exec npm run dev
}

cmd_start() {
  detect_compose
  start_docker
  start_db
  report_data
  install_deps
  start_web
}

cmd_status() {
  detect_compose
  step "Status"
  docker_up && ok "docker engine: up" || warn "docker engine: down"

  if db_running; then
    ok "mariadb: up (${DB_CONTAINER}, database ${DB_NAME})"
    report_data
  else
    warn "mariadb: down (${DB_CONTAINER})"
  fi

  # bash /dev/tcp probe: works where lsof is not installed.
  if (exec 3<>"/dev/tcp/127.0.0.1/${WEB_PORT}") 2>/dev/null; then
    ok "web: something is listening on :${WEB_PORT}"
  else
    warn "web: not running"
  fi
}

cmd_stop() {
  detect_compose
  if [ "$LOCAL_DB" = 0 ]; then
    warn "${DB_CONTAINER} is not this project's container — leaving it running"
    return
  fi
  step "Stopping MariaDB"
  "${COMPOSE[@]}" stop db >/dev/null 2>&1 || true
  ok "stopped (data volume preserved)"
  printf '  %sThe Docker VM is left running; stop it with: colima stop%s\n' "$dim" "$reset"
}

run_etl_container() {
  local target="$1"
  shift
  # The ETL runs in a throwaway Python container on the database's network,
  # so the host needs only Docker. -e values override the env file's.
  docker run --rm \
    --network "$ETL_NETWORK" \
    --env-file "$ETL_ENV_FILE" \
    -e DBHOST="$ETL_DBHOST" \
    -e DBPORT="$ETL_DBPORT" \
    -e HELIX7_DBNAME="$DB_NAME" \
    -v "$APP_DIR:/app:z" \
    -w /app/etl \
    python:3.13-slim \
    bash -lc 'pip install -q httpx mysql-connector-python tenacity && python "/app/etl/$1" "${@:2}"' \
    -- "$target" "$@"
}

cmd_etl() {
  detect_compose
  start_docker
  start_db
  step "ETL pipeline"
  run_etl_container run_all.py
}

# Scheduled data refresh — safe to run from cron. Logs to etl/logs/ and records
# the run in the `dataset_meta` table. Passes any extra args through to update.py.
cmd_update() {
  detect_compose
  start_docker
  start_db

  mkdir -p etl/logs
  local ts log
  ts="$(date +%Y%m%d-%H%M%S)"
  log="etl/logs/update-${ts}.log"

  step "Data refresh"
  printf '  %slogging to %s%s\n' "$dim" "$log" "$reset"
  shift || true   # drop the "update" arg; forward the rest
  if run_etl_container update.py "$@" 2>&1 | tee "$log"; then
    ok "refresh complete"
  else
    die "refresh failed — see $log"
  fi
  report_data
  # prune logs older than 90 days
  find etl/logs -name 'update-*.log' -mtime +90 -delete 2>/dev/null || true
}

case "${1:-start}" in
  start)  cmd_start  ;;
  status) cmd_status ;;
  stop)   cmd_stop   ;;
  etl)    cmd_etl    ;;
  update) cmd_update "$@" ;;
  *) echo "usage: ./run [start|status|stop|etl|update]" >&2; exit 2 ;;
esac
