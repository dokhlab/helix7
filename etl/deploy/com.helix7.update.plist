<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.helix7.update</string>

    <!-- Runs: cd into the app and invoke `./run update` -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <!-- edit this absolute path to your checkout -->
        <string>cd "$HOME/Helix7/App" &amp;&amp; ./run update</string>
    </array>

    <!-- 03:30 on the 1st of each month -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Day</key><integer>1</integer>
        <key>Hour</key><integer>3</integer>
        <key>Minute</key><integer>30</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/helix7-update.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/helix7-update.err.log</string>
</dict>
</plist>
