# Copy to .env.local (./run does this for you). Read by Next.js and by ./run.
# These match the local MariaDB in docker-compose.yml; they are not secrets.

# --- database the web app reads ---
DBHOST=127.0.0.1
DBPORT=3307
HELIX7_DBNAME=helix7
HELIX7_DBUSER=helix7
HELIX7_DBPASS=helix7

# --- ./run only: where the containerised ETL reaches the database ---
# HELIX7_ETL_NETWORK=helix7_default   # docker network the ETL joins
# HELIX7_ETL_DBHOST=db                # database host as seen from that network
# HELIX7_ETL_DBPORT=3306
# HELIX7_ETL_ENV_FILE=.env.local      # extra env (credentials) passed to the ETL
# HELIX7_DB_CONTAINER=helix7-db       # container ./run status queries for counts
